+namespace blink {
+
+using mojom::blink::PermissionName;
+using mojom::blink::PermissionService;
+
+class NFCIsoDepReader::ReadAbortAlgorithm final
+    : public AbortSignal::Algorithm {
+ public:
+  ReadAbortAlgorithm(NFCIsoDepReader* reader, AbortSignal* signal)
+      : reader_(reader), abort_signal_(signal) {}
+  ~ReadAbortAlgorithm() override = default;
+
+  void Run() override { reader_->ReadAbort(abort_signal_); }
+
+  void Trace(Visitor* visitor) const override {
+    visitor->Trace(reader_);
+    visitor->Trace(abort_signal_);
+    Algorithm::Trace(visitor);
+  }
+
+ private:
+  Member<NFCIsoDepReader> reader_;
+  Member<AbortSignal> abort_signal_;
+};
+
+// static
+NFCIsoDepReader* NFCIsoDepReader::Create(ExecutionContext* context) {
+  return MakeGarbageCollected<NFCIsoDepReader>(context);
+}
+
+NFCIsoDepReader::NFCIsoDepReader(ExecutionContext* context)
+    : ActiveScriptWrappable<NFCIsoDepReader>({}),
+      ExecutionContextLifecycleObserver(context),
+      nfc_proxy_(NFCProxy::From(*To<LocalDOMWindow>(context))),
+      permission_service_(context) {}
+
+NFCIsoDepReader::~NFCIsoDepReader() = default;
+
+const AtomicString& NFCIsoDepReader::InterfaceName() const {
+  return event_target_names::kNFCIsoDepReader;
+}
+
+ExecutionContext* NFCIsoDepReader::GetExecutionContext() const {
+  return ExecutionContextLifecycleObserver::GetExecutionContext();
+}
+
+bool NFCIsoDepReader::HasPendingActivity() const {
+  return GetExecutionContext() && nfc_proxy_->IsIsoDepReading(this) &&
+         HasEventListeners();
+}
+
+ScriptPromise<IDLUndefined> NFCIsoDepReader::scan(
+    ScriptState* script_state,
+    const NFCIsoDepScanOptions* options,
+    ExceptionState& exception_state) {
+  LocalDOMWindow* window = To<LocalDOMWindow>(GetExecutionContext());
+  // Like Web NFC, only the top-level browsing context may use the reader.
+  if (!window || !window->GetFrame() || !window->GetFrame()->IsMainFrame()) {
+    exception_state.ThrowDOMException(
+        DOMExceptionCode::kInvalidStateError,
+        "NFCIsoDepReader can only be used in a top-level browsing context.");
+    return EmptyPromise();
+  }
+
+  // Scanning requires a user gesture, so that a page cannot silently wait
+  // for an identity document to be presented.
+  if (!LocalFrame::HasTransientUserActivation(window->GetFrame())) {
+    exception_state.ThrowDOMException(
+        DOMExceptionCode::kNotAllowedError,
+        "scan() requires a user gesture.");
+    return EmptyPromise();
+  }
+
+  if (scan_signal_ && scan_abort_handle_) {
+    scan_signal_->RemoveAlgorithm(scan_abort_handle_);
+    scan_abort_handle_.Clear();
+  }
+  scan_signal_ = options->getSignalOr(nullptr);
+  if (scan_signal_) {
+    if (scan_signal_->aborted()) {
+      return ScriptPromise<IDLUndefined>::Reject(
+          script_state, scan_signal_->reason(script_state));
+    }
+    scan_abort_handle_ = scan_signal_->AddAlgorithm(
+        MakeGarbageCollected<ReadAbortAlgorithm>(this, scan_signal_));
+  }
+
+  if (scan_resolver_ || nfc_proxy_->IsIsoDepReading(this)) {
+    exception_state.ThrowDOMException(DOMExceptionCode::kInvalidStateError,
+                                      "A scan() operation is ongoing.");
+    return EmptyPromise();
+  }
+
+  scan_resolver_ = MakeGarbageCollected<ScriptPromiseResolver<IDLUndefined>>(
+      script_state, exception_state.GetContext());
+  GetPermissionService()->RequestPermission(
+      CreatePermissionDescriptor(PermissionName::NFC),
+      BindOnce(&NFCIsoDepReader::ReadOnRequestPermission,
+               WrapPersistent(this)));
+  return scan_resolver_->Promise();
+}
+
+void NFCIsoDepReader::ReadOnRequestPermission(
+    mojom::blink::PermissionStatusWithDetailsPtr status) {
+  if (!scan_resolver_) {
+    return;
+  }
+  if (status->status != mojom::blink::PermissionStatus::GRANTED) {
+    scan_resolver_->RejectWithDOMException(DOMExceptionCode::kNotAllowedError,
+                                           "NFC permission request denied.");
+    scan_resolver_.Clear();
+    return;
+  }
+#if BUILDFLAG(IS_IOS) && !BUILDFLAG(IS_IOS_TVOS)
+  // TODO: implement with Core NFC (NFCTagReaderSession / NFCISO7816Tag).
+  scan_resolver_->RejectWithDOMException(
+      DOMExceptionCode::kNotSupportedError,
+      "NFCIsoDepReader is not yet supported on this platform.");
+  scan_resolver_.Clear();
+#else
+  nfc_proxy_->StartIsoDepReading(
+      this,
+      BindOnce(&NFCIsoDepReader::ReadOnRequestCompleted, WrapPersistent(this)));
+#endif
+}
+
+void NFCIsoDepReader::ReadOnRequestCompleted(
+    device::mojom::blink::NDEFErrorPtr error) {
+  if (!scan_resolver_) {
+    return;
+  }
+  if (error) {
+    scan_resolver_->RejectWithDOMException(
+        NFCErrorTypeToDOMExceptionCode(error->error_type),
+        error->error_message);
+  } else {
+    scan_resolver_->Resolve();
+  }
+  scan_resolver_.Clear();
+}
+
+void NFCIsoDepReader::OnIsoDepTag(
+    device::mojom::blink::NFCIsoDepTagInfoPtr info,
+    mojo::PendingRemote<device::mojom::blink::NFCIsoDepTag> tag) {
+  auto* iso_dep_tag = MakeGarbageCollected<NFCIsoDepTag>(
+      GetExecutionContext(), std::move(info), std::move(tag));
+  DispatchEvent(*MakeGarbageCollected<NFCIsoDepReadingEvent>(
+      event_type_names::kReading, iso_dep_tag));
+}
+
+void NFCIsoDepReader::OnReadingError(const String& message) {
+  GetExecutionContext()->AddConsoleMessage(MakeGarbageCollected<ConsoleMessage>(
+      mojom::blink::ConsoleMessageSource::kJavaScript,
+      mojom::blink::ConsoleMessageLevel::kInfo, message));
+  DispatchEvent(*Event::Create(event_type_names::kReadingerror));
+}
+
+void NFCIsoDepReader::ReadOnMojoConnectionError() {
+  if (!scan_resolver_) {
+    return;
+  }
+  scan_resolver_->RejectWithDOMException(
+      DOMExceptionCode::kNotSupportedError,
+      "Web NFC is unavailable or permission denied.");
+  scan_resolver_.Clear();
+}
+
+void NFCIsoDepReader::ContextDestroyed() {
+  nfc_proxy_->StopIsoDepReading(this);
+  scan_abort_handle_.Clear();
+}
+
+void NFCIsoDepReader::ReadAbort(AbortSignal* signal) {
+  nfc_proxy_->StopIsoDepReading(this);
+  scan_abort_handle_.Clear();
+  if (!scan_resolver_) {
+    return;
+  }
+  ScriptState* script_state = scan_resolver_->GetScriptState();
+  ScriptState::Scope script_state_scope(script_state);
+  scan_resolver_->Reject(signal->reason(script_state));
+  scan_resolver_.Clear();
+}
+
+void NFCIsoDepReader::Dispose() {
+  nfc_proxy_->StopIsoDepReading(this);
+}
+
+PermissionService* NFCIsoDepReader::GetPermissionService() {
+  if (!permission_service_.is_bound()) {
+    ConnectToPermissionService(
+        GetExecutionContext(),
+        permission_service_.BindNewPipeAndPassReceiver(
+            GetExecutionContext()->GetTaskRunner(TaskType::kMiscPlatformAPI)));
+  }
+  return permission_service_.get();
+}
+
+void NFCIsoDepReader::Trace(Visitor* visitor) const {
+  visitor->Trace(nfc_proxy_);
+  visitor->Trace(scan_resolver_);
+  visitor->Trace(scan_signal_);
+  visitor->Trace(scan_abort_handle_);
+  visitor->Trace(permission_service_);
+  EventTarget::Trace(visitor);
+  ActiveScriptWrappable::Trace(visitor);
+  ExecutionContextLifecycleObserver::Trace(visitor);
+}
+
+}  // namespace blink
