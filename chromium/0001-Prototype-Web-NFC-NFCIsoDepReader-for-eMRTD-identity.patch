+void NFCProxy::OnIsoDepError(const Vector<uint32_t>& watch_ids,
+                             device::mojom::blink::NDEFErrorPtr error) {
+  IsoDepReaderMap copy = iso_dep_readers_;
+  for (auto& pair : copy) {
+    if (watch_ids.Contains(pair.value)) {
+      pair.key->OnReadingError(error->error_message);
