+      ExceptionState&);
+  ScriptPromise<IDLUndefined> close(ScriptState*);
+
+  void Trace(Visitor*) const override;
+
+ private:
+  using TransceiveResolver = ScriptPromiseResolver<NotShared<DOMUint8Array>>;
