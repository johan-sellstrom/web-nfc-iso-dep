+void NFCProxy::OnIsoDepReaderRegistered(
+    NFCIsoDepReader* reader,
+    uint32_t watch_id,
+    device::mojom::blink::NFC::WatchIsoDepCallback callback,
+    device::mojom::blink::NDEFErrorPtr error) {
+  DCHECK(reader);
+  if (!iso_dep_readers_.Contains(reader) ||
+      iso_dep_readers_.at(reader) != watch_id) {
+    return;
+  }
+  if (error) {
+    iso_dep_readers_.erase(reader);
+  }
+  std::move(callback).Run(std::move(error));
+}
