+// Prototype reader for ISO-DEP identity documents (ICAO Doc 9303 eMRTDs).
+class MODULES_EXPORT NFCIsoDepReader
+    : public EventTarget,
+      public ActiveScriptWrappable<NFCIsoDepReader>,
+      public ExecutionContextLifecycleObserver {
+  DEFINE_WRAPPERTYPEINFO();
+  USING_PRE_FINALIZER(NFCIsoDepReader, Dispose);
+
+ public:
+  static NFCIsoDepReader* Create(ExecutionContext*);
+
+  explicit NFCIsoDepReader(ExecutionContext*);
+  ~NFCIsoDepReader() override;
+
+  // EventTarget overrides.
+  const AtomicString& InterfaceName() const override;
+  ExecutionContext* GetExecutionContext() const override;
+
+  // ActiveScriptWrappable overrides.
+  bool HasPendingActivity() const override;
+
+  DEFINE_ATTRIBUTE_EVENT_LISTENER(reading, kReading)
+  DEFINE_ATTRIBUTE_EVENT_LISTENER(readingerror, kReadingerror)
+
+  ScriptPromise<IDLUndefined> scan(ScriptState*,
+                                   const NFCIsoDepScanOptions*,
+                                   ExceptionState&);
+
+  void Trace(Visitor*) const override;
+  void Dispose();
+
+  // Called by NFCProxy.
+  void OnIsoDepTag(device::mojom::blink::NFCIsoDepTagInfoPtr,
+                   mojo::PendingRemote<device::mojom::blink::NFCIsoDepTag>);
+  void OnReadingError(const String& message);
+  void ReadOnMojoConnectionError();
+
+ private:
+  class ReadAbortAlgorithm;
+
+  // ExecutionContextLifecycleObserver overrides.
+  void ContextDestroyed() override;
+
+  void ReadAbort(AbortSignal*);
+  void ReadOnRequestPermission(mojom::blink::PermissionStatusWithDetailsPtr);
+  void ReadOnRequestCompleted(device::mojom::blink::NDEFErrorPtr);
+
+  mojom::blink::PermissionService* GetPermissionService();
+
+  Member<NFCProxy> nfc_proxy_;
+  Member<ScriptPromiseResolver<IDLUndefined>> scan_resolver_;
+  Member<AbortSignal> scan_signal_;
+  Member<AbortSignal::AlgorithmHandle> scan_abort_handle_;
+  HeapMojoRemote<mojom::blink::PermissionService> permission_service_;
+};
+
