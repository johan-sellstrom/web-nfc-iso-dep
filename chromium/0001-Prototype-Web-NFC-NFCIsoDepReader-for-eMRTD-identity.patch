diff --git a/services/device/nfc/android/java/src/org/chromium/device/nfc/EmrtdPolicy.java b/services/device/nfc/android/java/src/org/chromium/device/nfc/EmrtdPolicy.java
new file mode 100644
index 0000000000..fac4bbd8fe
--- /dev/null
+++ b/services/device/nfc/android/java/src/org/chromium/device/nfc/EmrtdPolicy.java
@@ -0,0 +1,136 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.device.nfc;
+
+import android.nfc.tech.IsoDep;
+
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+
+import java.io.IOException;
+import java.util.Arrays;
+
+/**
+ * Browser-enforced policy for NFCIsoDepReader sessions. Only ISO-DEP tags that identify as
+ * electronic machine readable travel documents (ICAO Doc 9303) are exposed to the page, and
+ * plaintext commands are filtered so that no other card application can be selected.
+ */
+@NullMarked
+final class EmrtdPolicy {
+    /** ICAO eMRTD LDS1 application identifier. */
+    static final byte[] EMRTD_AID = {
+        (byte) 0xA0, 0x00, 0x00, 0x02, 0x47, 0x10, 0x01
+    };
+
+    /** id-PACE (BSI TR-03110 / ICAO 9303-11) OID prefix 0.4.0.127.0.7.2.2.4, DER-encoded. */
+    private static final byte[] PACE_OID_PREFIX = {
+        0x04, 0x00, 0x7F, 0x00, 0x07, 0x02, 0x02, 0x04
+    };
+
+    private static final int INS_SELECT = 0xA4;
+
+    private EmrtdPolicy() {}
+
+    /**
+     * Returns true if the connected tag is an eMRTD: either the eMRTD application can be selected
+     * in plaintext (BAC and most PACE documents), or EF.CardAccess at the master file advertises
+     * PACE (PACE-only documents). Must be called off the UI thread.
+     */
+    static boolean isEmrtd(IsoDep isoDep) throws IOException {
+        byte[] selectAid = new byte[5 + EMRTD_AID.length];
+        selectAid[0] = 0x00;
+        selectAid[1] = (byte) INS_SELECT;
+        selectAid[2] = 0x04;
+        selectAid[3] = 0x0C;
+        selectAid[4] = (byte) EMRTD_AID.length;
+        System.arraycopy(EMRTD_AID, 0, selectAid, 5, EMRTD_AID.length);
+        if (isSuccess(isoDep.transceive(selectAid))) return true;
+
+        byte[] selectCardAccess = {0x00, (byte) INS_SELECT, 0x02, 0x0C, 0x02, 0x01, 0x1C};
+        if (!isSuccess(isoDep.transceive(selectCardAccess))) return false;
+        byte[] cardAccess = isoDep.transceive(new byte[] {0x00, (byte) 0xB0, 0x00, 0x00, 0x00});
+        return cardAccess.length > 2
+                && isSuccessOrWarning(cardAccess)
+                && indexOf(cardAccess, PACE_OID_PREFIX) >= 0;
+    }
+
+    /**
+     * Checks a command APDU from the page. Returns null if the command may be sent to the tag,
+     * otherwise a human readable reason.
+     */
+    static @Nullable String checkCommand(byte[] apdu) {
+        if (apdu.length < 4) return "Malformed command APDU.";
+        int cla = apdu[0] & 0xFF;
+        int ins = apdu[1] & 0xFF;
+        int p1 = apdu[2] & 0xFF;
+
+        // Proprietary classes (e.g. EMV payment commands) are never needed for eMRTDs.
+        if ((cla & 0x80) != 0) return "Proprietary command classes are not allowed.";
+
+        // Secure messaging commands are opaque to the browser. They are only meaningful to a chip
+        // that has already been classified as an eMRTD and require the document's access key.
+        if ((cla & 0x0C) != 0) return null;
+
+        switch (ins) {
+            case INS_SELECT:
+                if (p1 == 0x04) {
+                    byte[] aid = commandData(apdu);
+                    if (aid != null && Arrays.equals(aid, EMRTD_AID)) return null;
+                    return "Only the eMRTD application may be selected.";
+                }
+                // Selection by file identifier (MF, EF.CardAccess, EF.COM, data groups).
+                if (p1 == 0x00 || p1 == 0x02) return null;
+                return "Unsupported SELECT mode.";
+            case 0xB0: // READ BINARY
+            case 0xB1: // READ BINARY (odd INS)
+            case 0x84: // GET CHALLENGE (BAC)
+            case 0x82: // EXTERNAL AUTHENTICATE (BAC)
+            case 0x88: // INTERNAL AUTHENTICATE (Active Authentication)
+            case 0x22: // MANAGE SECURITY ENVIRONMENT (PACE, Chip Authentication)
+            case 0x86: // GENERAL AUTHENTICATE (PACE, Chip Authentication)
+                return null;
+            default:
+                return "Command not allowed for eMRTD sessions.";
+        }
+    }
+
+    /** Returns the command data field of a short or extended APDU, or null if absent. */
+    private static byte @Nullable [] commandData(byte[] apdu) {
+        if (apdu.length < 6) return null;
+        int lc = apdu[4] & 0xFF;
+        int offset = 5;
+        if (lc == 0) {
+            // Extended length: 00 Lc1 Lc2.
+            if (apdu.length < 8) return null;
+            lc = ((apdu[5] & 0xFF) << 8) | (apdu[6] & 0xFF);
+            offset = 7;
+        }
+        if (lc == 0 || offset + lc > apdu.length) return null;
+        return Arrays.copyOfRange(apdu, offset, offset + lc);
+    }
+
+    private static boolean isSuccess(byte[] response) {
+        int n = response.length;
+        return n >= 2 && response[n - 2] == (byte) 0x90 && response[n - 1] == 0x00;
+    }
+
+    private static boolean isSuccessOrWarning(byte[] response) {
+        int n = response.length;
+        // 9000, or 6282 (end of file reached before Le bytes) which is common for EF.CardAccess.
+        return isSuccess(response)
+                || (n >= 2 && response[n - 2] == 0x62 && response[n - 1] == (byte) 0x82);
+    }
+
+    private static int indexOf(byte[] haystack, byte[] needle) {
+        outer:
+        for (int i = 0; i + needle.length <= haystack.length; i++) {
+            for (int j = 0; j < needle.length; j++) {
+                if (haystack[i + j] != needle[j]) continue outer;
+            }
+            return i;
+        }
+        return -1;
+    }
+}
diff --git a/services/device/nfc/android/java/src/org/chromium/device/nfc/IsoDepSession.java b/services/device/nfc/android/java/src/org/chromium/device/nfc/IsoDepSession.java
new file mode 100644
index 0000000000..98449cbeb7
--- /dev/null
+++ b/services/device/nfc/android/java/src/org/chromium/device/nfc/IsoDepSession.java
@@ -0,0 +1,111 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.device.nfc;
+
+import android.nfc.TagLostException;
+import android.nfc.tech.IsoDep;
+
+import org.chromium.base.Log;
+import org.chromium.base.task.PostTask;
+import org.chromium.base.task.SequencedTaskRunner;
+import org.chromium.base.task.TaskTraits;
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.device.mojom.NdefError;
+import org.chromium.device.mojom.NdefErrorType;
+import org.chromium.device.mojom.NfcIsoDepTag;
+import org.chromium.mojo.system.MojoException;
+
+import java.io.IOException;
+
+/**
+ * Implementation of device.mojom.NFCIsoDepTag: one session with a connected eMRTD tag. Commands
+ * are checked against {@link EmrtdPolicy} on the calling (UI) thread and exchanged with the tag
+ * on a sequenced background runner, since IsoDep#transceive blocks.
+ */
+@NullMarked
+class IsoDepSession implements NfcIsoDepTag {
+    private static final String TAG = "IsoDepSession";
+
+    private final IsoDep mIsoDep;
+    private final SequencedTaskRunner mTaskRunner;
+    private final Runnable mOnClosed;
+    private boolean mClosed;
+
+    IsoDepSession(IsoDep isoDep, SequencedTaskRunner taskRunner, Runnable onClosed) {
+        mIsoDep = isoDep;
+        mTaskRunner = taskRunner;
+        mOnClosed = onClosed;
+    }
+
+    @Override
+    public void transceive(byte[] command, Transceive_Response callback) {
+        if (mClosed) {
+            callback.call(null, createError(NdefErrorType.IO_ERROR, "The session is closed."));
+            return;
+        }
+        String reason = EmrtdPolicy.checkCommand(command);
+        if (reason != null) {
+            callback.call(null, createError(NdefErrorType.NOT_ALLOWED, reason));
+            return;
+        }
+        if (command.length > mIsoDep.getMaxTransceiveLength()) {
+            callback.call(
+                    null,
+                    createError(
+                            NdefErrorType.INVALID_MESSAGE,
+                            "Command exceeds the tag's maximum transceive length."));
+            return;
+        }
+        mTaskRunner.execute(
+                () -> {
+                    byte[] response = null;
+                    NdefError error = null;
+                    try {
+                        response = mIsoDep.transceive(command);
+                    } catch (TagLostException e) {
+                        error = createError(NdefErrorType.IO_ERROR, "The tag was lost.");
+                    } catch (IOException | IllegalStateException | SecurityException e) {
+                        Log.w(TAG, "transceive failed: " + e.getMessage());
+                        error =
+                                createError(
+                                        NdefErrorType.IO_ERROR,
+                                        "Transceive failed: " + e.getMessage());
+                    }
+                    final byte[] finalResponse = response;
+                    final NdefError finalError = error;
+                    PostTask.postTask(
+                            TaskTraits.UI_USER_BLOCKING,
+                            () -> callback.call(finalResponse, finalError));
+                });
+    }
+
+    /** Ends the session. Called when the page drops the pipe or the browser cancels the scan. */
+    @Override
+    public void close() {
+        if (mClosed) return;
+        mClosed = true;
+        mTaskRunner.execute(
+                () -> {
+                    try {
+                        mIsoDep.close();
+                    } catch (IOException e) {
+                        // Ignored: the tag may already be out of range.
+                    }
+                });
+        mOnClosed.run();
+    }
+
+    @Override
+    public void onConnectionError(MojoException e) {
+        close();
+    }
+
+    static NdefError createError(int errorType, String errorMessage) {
+        NdefError error = new NdefError();
+        error.errorType = errorType;
+        error.errorMessage = errorMessage;
+        return error;
+    }
+}
