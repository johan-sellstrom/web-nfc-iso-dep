+
+        if (maybeHandleIsoDepTag(tag)) {
+            // A tag without NDEF support was taken by the ISO-DEP path; don't report it to NDEF
+            // readers as unsupported.
+            if (Ndef.get(tag) == null && NdefFormatable.get(tag) == null) return;
+        }
         processPendingOperations(NfcTagHandler.create(tag));
     }
 
+    /**
+     * Starts eMRTD classification for |tag| if there are ISO-DEP watchers and the tag supports
+     * ISO-DEP. Returns true if the tag was taken by the ISO-DEP path.
+     */
+    private boolean maybeHandleIsoDepTag(Tag tag) {
+        if (mIsoDepWatchIds.isEmpty() || mClient == null || mOperationsSuspended) return false;
+        if (NfcBlocklist.getInstance().isTagBlocked(tag)) return false;
+        IsoDep isoDep = IsoDep.get(tag);
+        if (isoDep == null) return false;
+
+        // A new tag replaces any previous session.
+        closeIsoDepSession();
+        mIsoDepTaskRunner.execute(
+                () -> {
+                    boolean isEmrtd = false;
+                    try {
+                        if (!isoDep.isConnected()) isoDep.connect();
+                        isoDep.setTimeout(5000);
+                        isEmrtd = EmrtdPolicy.isEmrtd(isoDep);
+                    } catch (IOException | IllegalStateException | SecurityException e) {
+                        Log.w(TAG, "ISO-DEP classification failed: " + e.getMessage());
+                    }
+                    if (!isEmrtd) {
+                        try {
+                            isoDep.close();
+                        } catch (IOException e) {
+                            // Ignored: the tag may already be out of range.
+                        }
+                    }
+                    final boolean finalIsEmrtd = isEmrtd;
+                    PostTask.postTask(
+                            TaskTraits.UI_USER_BLOCKING,
+                            () -> onIsoDepTagClassified(isoDep, finalIsEmrtd));
+                });
+        return true;
+    }
+
+    /** Hands a classified eMRTD tag to the most recent ISO-DEP watcher, or reports an error. */
+    private void onIsoDepTagClassified(IsoDep isoDep, boolean isEmrtd) {
+        if (mClient == null || mIsoDepWatchIds.isEmpty() || mOperationsSuspended) {
+            if (isEmrtd) {
+                try {
+                    isoDep.close();
+                } catch (IOException e) {
+                    // Ignored.
+                }
+            }
+            return;
+        }
+        if (!isEmrtd) {
+            mClient.onIsoDepError(
+                    CollectionUtil.integerCollectionToIntArray(mIsoDepWatchIds),
+                    createError(
+                            NdefErrorType.NOT_SUPPORTED,
+                            "This tag is not an identity document (eMRTD)."));
+            return;
+        }
+
+        NfcIsoDepTagInfo info = new NfcIsoDepTagInfo();
+        info.historicalBytes = isoDep.getHistoricalBytes();
+        info.maxTransceiveLength = isoDep.getMaxTransceiveLength();
+        info.extendedLengthApdu = isoDep.isExtendedLengthApduSupported();
+
+        IsoDepSession[] holder = new IsoDepSession[1];
+        IsoDepSession session =
+                new IsoDepSession(
+                        isoDep,
+                        mIsoDepTaskRunner,
+                        () -> {
+                            if (mIsoDepSession == holder[0]) mIsoDepSession = null;
+                        });
+        holder[0] = session;
+        mIsoDepSession = session;
+        int watchId = mIsoDepWatchIds.get(mIsoDepWatchIds.size() - 1);
+        mClient.onIsoDepTag(watchId, info, session);
+    }
+
+    private void closeIsoDepSession() {
+        IsoDepSession session = mIsoDepSession;
+        mIsoDepSession = null;
+        if (session != null) session.close();
+    }
+
     /** Processes pending operation when NFC tag is in proximity. */
