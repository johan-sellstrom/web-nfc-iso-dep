+#include "third_party/blink/renderer/platform/wtf/functional.h"
+
+namespace blink {
+
+DOMExceptionCode NFCErrorTypeToDOMExceptionCode(
+    device::mojom::blink::NDEFErrorType error_type) {
+  switch (error_type) {
+    case device::mojom::blink::NDEFErrorType::NOT_ALLOWED:
+      return DOMExceptionCode::kNotAllowedError;
+    case device::mojom::blink::NDEFErrorType::NOT_SUPPORTED:
+      return DOMExceptionCode::kNotSupportedError;
+    case device::mojom::blink::NDEFErrorType::NOT_READABLE:
+      return DOMExceptionCode::kNotReadableError;
+    case device::mojom::blink::NDEFErrorType::INVALID_MESSAGE:
+      return DOMExceptionCode::kSyntaxError;
+    case device::mojom::blink::NDEFErrorType::OPERATION_CANCELLED:
+      return DOMExceptionCode::kAbortError;
+    case device::mojom::blink::NDEFErrorType::IO_ERROR:
+      return DOMExceptionCode::kNetworkError;
+  }
+  NOTREACHED();
+}
+
+NFCIsoDepTag::NFCIsoDepTag(
+    ExecutionContext* context,
+    device::mojom::blink::NFCIsoDepTagInfoPtr info,
+    mojo::PendingRemote<device::mojom::blink::NFCIsoDepTag> tag)
+    : remote_(context) {
+  if (info->historical_bytes) {
+    historical_bytes_ =
+        NotShared(DOMUint8Array::Create(base::span(*info->historical_bytes)));
+  }
+  max_transceive_length_ = info->max_transceive_length;
+  extended_length_apdu_ = info->extended_length_apdu;
+
+  remote_.Bind(std::move(tag),
+               context->GetTaskRunner(TaskType::kMiscPlatformAPI));
+  remote_.set_disconnect_handler(
+      BindOnce(&NFCIsoDepTag::OnConnectionError, WrapWeakPersistent(this)));
+}
+
+NFCIsoDepTag::~NFCIsoDepTag() = default;
+
+NotShared<DOMUint8Array> NFCIsoDepTag::historicalBytes() const {
+  return historical_bytes_;
+}
+
+ScriptPromise<NotShared<DOMUint8Array>> NFCIsoDepTag::transceive(
+    ScriptState* script_state,
+    const V8BufferSource* command_apdu,
+    ExceptionState& exception_state) {
+  if (closed_ || !remote_.is_bound()) {
+    exception_state.ThrowDOMException(DOMExceptionCode::kInvalidStateError,
+                                      "The tag session is closed.");
+    return EmptyPromise();
+  }
+
+  DOMArrayPiece piece(command_apdu);
+  if (piece.IsDetached() || piece.ByteLength() < 4) {
+    exception_state.ThrowTypeError("A command APDU is at least 4 bytes.");
+    return EmptyPromise();
+  }
+  if (piece.ByteLength() > max_transceive_length_) {
+    exception_state.ThrowDOMException(
+        DOMExceptionCode::kSyntaxError,
+        "The command APDU exceeds maxTransceiveLength.");
+    return EmptyPromise();
+  }
+  Vector<uint8_t> apdu(base::span<const uint8_t>(piece.ByteSpan()));
+
+  auto* resolver = MakeGarbageCollected<TransceiveResolver>(
+      script_state, exception_state.GetContext());
+  pending_.insert(resolver);
+  remote_->Transceive(
+      std::move(apdu),
+      BindOnce(&NFCIsoDepTag::OnTransceiveResponse, WrapPersistent(this),
+               WrapPersistent(resolver)));
+  return resolver->Promise();
+}
+
+ScriptPromise<IDLUndefined> NFCIsoDepTag::close(ScriptState* script_state) {
+  if (!closed_) {
+    closed_ = true;
+    remote_.reset();
+    RejectPending(DOMExceptionCode::kAbortError, "The tag session was closed.");
+  }
+  return ToResolvedUndefinedPromise(script_state);
+}
+
+void NFCIsoDepTag::OnTransceiveResponse(
+    TransceiveResolver* resolver,
+    const std::optional<Vector<uint8_t>>& response,
+    device::mojom::blink::NDEFErrorPtr error) {
+  if (!pending_.Contains(resolver)) {
+    return;
+  }
+  pending_.erase(resolver);
+  if (error) {
+    resolver->RejectWithDOMException(
+        NFCErrorTypeToDOMExceptionCode(error->error_type),
+        error->error_message);
+    return;
+  }
+  if (!response) {
+    resolver->RejectWithDOMException(DOMExceptionCode::kNetworkError,
+                                     "No response from the tag.");
+    return;
+  }
+  resolver->Resolve(NotShared(DOMUint8Array::Create(base::span(*response))));
+}
+
+void NFCIsoDepTag::OnConnectionError() {
+  closed_ = true;
+  remote_.reset();
+  RejectPending(DOMExceptionCode::kNetworkError,
+                "The tag was removed or the session ended.");
+}
+
+void NFCIsoDepTag::RejectPending(DOMExceptionCode code,
+                                 const String& message) {
+  // Rejecting may run script; swap first to avoid concurrent modification.
+  HeapHashSet<Member<TransceiveResolver>> pending;
+  pending_.swap(pending);
+  for (auto& resolver : pending) {
+    resolver->RejectWithDOMException(code, message);
+  }
+}
+
+void NFCIsoDepTag::Trace(Visitor* visitor) const {
+  visitor->Trace(historical_bytes_);
+  visitor->Trace(remote_);
+  visitor->Trace(pending_);
+  ScriptWrappable::Trace(visitor);
+}
+
+}  // namespace blink
