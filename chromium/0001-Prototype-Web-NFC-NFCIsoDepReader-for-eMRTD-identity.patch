+    mojo::PendingRemote<device::mojom::blink::NFCIsoDepTag> tag) {
+  IsoDepReaderMap copy = iso_dep_readers_;
+  for (auto& pair : copy) {
+    if (pair.value == watch_id) {
+      pair.key->OnIsoDepTag(std::move(info), std::move(tag));
