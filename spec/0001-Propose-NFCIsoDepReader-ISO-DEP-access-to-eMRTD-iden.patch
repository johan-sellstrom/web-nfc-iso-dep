 <!-- - - - - - - - - - - - - - - The Blocklist - - - - - - - - - - - - - - - -->
+<!-- - - - - - - - - - - - - - - NFCIsoDepReader - - - - - - - - - - - - - - -->
+<section id="the-nfcisodepreader-object" data-dfn-for="NFCIsoDepReader" data-link-for="NFCIsoDepReader">
+  <h2>The NFCIsoDepReader object</h2>
+  <div class="ednote">
+    This section is a proposed addition to Web NFC (ISO-DEP access to
+    electronic identity documents). It is not yet adopted by the Community
+    Group. A prototype exists in Chromium behind a runtime flag.
+  </div>
+
+  <p>
+    The <dfn>NFCIsoDepReader</dfn> exposes <a>ISO-DEP</a> cards that match an
+    <a>application policy</a> to the <a>browsing context</a>, as
+    {{NFCIsoDepTag}} objects with which the page exchanges
+    <a>command APDU</a>s. The only <a>application policy</a> defined by this
+    specification is for <a>eMRTD</a>s.
+  </p>
+  <pre class="idl">
+    enum NFCIsoDepApplication { "emrtd" };
+
+    dictionary NFCIsoDepScanOptions {
+      AbortSignal signal;
+      sequence&lt;NFCIsoDepApplication&gt; applications;
+    };
+
+    [SecureContext, Exposed=Window]
+    interface NFCIsoDepReader : EventTarget {
+      constructor();
+
+      attribute EventHandler onreading;
+      attribute EventHandler onreadingerror;
+
+      Promise&lt;undefined&gt; scan(optional NFCIsoDepScanOptions options={});
+    };
+
+    [SecureContext, Exposed=Window]
+    interface NFCIsoDepReadingEvent : Event {
+      constructor(DOMString type, NFCIsoDepReadingEventInit eventInitDict);
+
+      [SameObject] readonly attribute NFCIsoDepTag tag;
+    };
+
+    dictionary NFCIsoDepReadingEventInit : EventInit {
+      required NFCIsoDepTag tag;
+    };
+
+    [SecureContext, Exposed=Window]
+    interface NFCIsoDepTag {
+      readonly attribute Uint8Array? historicalBytes;
+      readonly attribute unsigned long maxTransceiveLength;
+      readonly attribute boolean extendedLengthApdu;
+
+      Promise&lt;Uint8Array&gt; transceive(BufferSource commandApdu);
+      Promise&lt;undefined&gt; close();
+    };
+  </pre>
+
+  <p>
+    The <dfn>onreading</dfn> is an {{EventHandler}} which is called when a
+    card matching an <a>application policy</a> is in proximity.
+  </p>
+  <p>
+    The <dfn>onreadingerror</dfn> is an {{EventHandler}} which is called when
+    an <a>ISO-DEP</a> card in proximity does not match any requested
+    <a>application policy</a>, or an error happens while classifying it.
+  </p>
+  <p data-dfn-for="NFCIsoDepScanOptions">
+    The <dfn>signal</dfn> member allows to abort the
+    {{NFCIsoDepReader/scan()}} operation. The <dfn>applications</dfn> member
+    lists the <a>application policies</a> the page requests. If it is not
+    present, it is treated as « {{NFCIsoDepApplication/"emrtd"}} ».
+  </p>
+  <p data-dfn-for="NFCIsoDepApplication">
+    The <dfn>"emrtd"</dfn> value identifies the <a>eMRTD application
+    policy</a>.
+  </p>
+  <p data-dfn-for="NFCIsoDepReadingEvent">
+    The <dfn>NFCIsoDepReadingEvent</dfn> is dispatched when a matching card
+    is in proximity. Its <dfn>tag</dfn> attribute is the {{NFCIsoDepTag}}
+    representing the session with that card.
+  </p>
+  <p data-dfn-for="NFCIsoDepReadingEventInit">
+    <dfn>NFCIsoDepReadingEventInit</dfn> initializes an
+    {{NFCIsoDepReadingEvent}} with the given <dfn>tag</dfn>.
+  </p>
+
+  <section><h3>ISO-DEP state associated with the settings object</h3>
+    <p>
+      The <a>NFC state</a> additionally has the following internal slots:
+    </p>
+    <table class="simple">
+      <thead>
+       <tr>
+        <th>Internal Slot</th>
+        <th>Initial value</th>
+        <th>Description (<em>non-normative</em>)</th>
+       </tr>
+      </thead>
+      <tbody>
+       <tr>
+        <td><dfn>[[\ActivatedIsoDepReaderList]]</dfn></td>
+        <td>empty <a>list</a></td>
+        <td>
+          A <a>list</a> of &lt;|reader:NFCIsoDepReader|,
+          |policies:list|&gt; tuples, in activation order, where |policies|
+          holds the <a>application policies</a> requested by |reader|.
+        </td>
+       </tr>
+       <tr>
+        <td><dfn>[[\ActiveIsoDepTag]]</dfn></td>
+        <td>null</td>
+        <td>
+          The {{NFCIsoDepTag}} of the current session, if any.
+        </td>
+       </tr>
+      </tbody>
+    </table>
+    <p>
+      The <dfn>activated ISO-DEP reader objects</dfn> is the value of the
+      <a>[[\ActivatedIsoDepReaderList]]</a> internal slot.
+    </p>
+    <p>
+      The <dfn>NFC task source</dfn> is a [=task source=] used to deliver
+      results of <a>ISO-DEP</a> exchanges.
+    </p>
+    <p>
+      To <dfn>close the active ISO-DEP session</dfn>, if
+      <a>[[\ActiveIsoDepTag]]</a> is not null, run the <a>close an ISO-DEP
+      session</a> steps given it, then set <a>[[\ActiveIsoDepTag]]</a> to
+      null.
+    </p>
+  </section>
+
+  <section data-dfn-for="NFCIsoDepTag" data-link-for="NFCIsoDepTag">
+    <h3>The NFCIsoDepTag interface</h3>
+    <p>
+      An <dfn>NFCIsoDepTag</dfn> represents a session with one card. It has
+      the following internal slots:
+    </p>
+    <table class="simple">
+      <thead>
+       <tr>
+        <th>Internal Slot</th>
+        <th>Initial value</th>
+        <th>Description (<em>non-normative</em>)</th>
+       </tr>
+      </thead>
+      <tbody>
+       <tr>
+        <td><dfn>[[\Policy]]</dfn></td>
+        <td>null</td>
+        <td>The <a>application policy</a> the card matched.</td>
+       </tr>
+       <tr>
+        <td><dfn>[[\Closed]]</dfn></td>
+        <td>false</td>
+        <td>Whether the session has ended.</td>
+       </tr>
+       <tr>
+        <td><dfn>[[\PendingTransceives]]</dfn></td>
+        <td>empty <a>list</a></td>
+        <td>Promises returned by {{NFCIsoDepTag/transceive()}} that are not yet settled.</td>
+       </tr>
+      </tbody>
+    </table>
+    <p>
+      The <dfn>historicalBytes</dfn> attribute returns the card's
+      <a>historical bytes</a>, or null if unavailable. The
+      <dfn>maxTransceiveLength</dfn> attribute returns the maximum length in
+      bytes of a <a>command APDU</a> accepted by
+      {{NFCIsoDepTag/transceive()}}. The <dfn>extendedLengthApdu</dfn>
+      attribute returns true if the card and <a>NFC adapter</a> support
+      extended-length <a>command APDU</a>s.
+    </p>
+
+    <section><h4>The <strong>transceive()</strong> method</h4>
+      <div>
+        The <dfn>transceive(commandApdu)</dfn> method steps are:
+        <ol class=algorithm>
+          <li>
+            Let |tag:NFCIsoDepTag| be [=this=].
+          </li>
+          <li>
+            If |tag|.<a>[[\Closed]]</a> is true, return [=a promise rejected
+            with=] an {{"InvalidStateError"}} {{DOMException}}.
+          </li>
+          <li>
+            Let |command:byte sequence| be a copy of the bytes held by
+            |commandApdu|.
+          </li>
+          <li>
+            If |command|'s [=byte sequence/length=] is less than 4, return
+            [=a promise rejected with=] a {{TypeError}}.
+          </li>
+          <li>
+            If |command|'s [=byte sequence/length=] is greater than
+            |tag|.{{NFCIsoDepTag/maxTransceiveLength}}, return [=a promise
+            rejected with=] a {{"SyntaxError"}} {{DOMException}}.
+          </li>
+          <li>
+            If the result of <a>check a command APDU</a> given |command| and
+            |tag|.<a>[[\Policy]]</a> is "`disallowed`", return [=a promise
+            rejected with=] a {{"NotAllowedError"}} {{DOMException}}.
+          </li>
+          <li>
+            Let |p:Promise| be a new {{Promise}} object and [=list/append=] it
+            to |tag|.<a>[[\PendingTransceives]]</a>.
+          </li>
+          <li>
+            Return |p| and run the following steps <a>in parallel</a>:
+            <ol>
+              <li>
+                Send |command| to the card over <a>ISO-DEP</a> and wait for the
+                <a>response APDU</a>. Commands of one {{NFCIsoDepTag}} are
+                sent in the order in which {{NFCIsoDepTag/transceive()}} was
+                called.
+              </li>
+              <li>
+                If |p| is no longer in |tag|.<a>[[\PendingTransceives]]</a>,
+                abort these steps.
+              </li>
+              <li>
+                [=Queue a global task=] on the <a>NFC task source</a> to run
+                the following steps:
+                <ol>
+                  <li>
+                    [=list/Remove=] |p| from |tag|.<a>[[\PendingTransceives]]</a>.
+                  </li>
+                  <li>
+                    If the card was removed or the exchange failed, reject |p|
+                    with a {{"NetworkError"}} {{DOMException}} and abort these
+                    steps.
+                  </li>
+                  <li>
+                    Resolve |p| with a new {{Uint8Array}} containing the
+                    <a>response APDU</a>, including its status bytes.
+                  </li>
+                </ol>
+              </li>
+            </ol>
+          </li>
+        </ol>
+      </div>
+      <p class="note">
+        The UA does not interpret status bytes. A card error such as
+        `6A 82` (file not found) resolves the promise; only transport failures
+        reject it.
+      </p>
+    </section>
+
+    <section><h4>The <strong>close()</strong> method</h4>
+      <p>
+        The <dfn>close()</dfn> method steps are: run the <a>close an ISO-DEP
+        session</a> steps given [=this=]; if [=this=] is the
+        <a data-link-for="NFCIsoDepReader">[[\ActiveIsoDepTag]]</a>, set
+        <a data-link-for="NFCIsoDepReader">[[\ActiveIsoDepTag]]</a> to null;
+        return [=a promise resolved with=] undefined.
+      </p>
+      <div>
+        To <dfn>close an ISO-DEP session</dfn> given an {{NFCIsoDepTag}}
+        |tag:NFCIsoDepTag|, run these steps:
+        <ol class=algorithm>
+          <li>
+            If |tag|.<a>[[\Closed]]</a> is true, abort these steps.
+          </li>
+          <li>
+            Set |tag|.<a>[[\Closed]]</a> to true.
+          </li>
+          <li>
+            [=list/For each=] |p| in |tag|.<a>[[\PendingTransceives]]</a>,
+            reject |p| with an {{"AbortError"}} {{DOMException}}.
+          </li>
+          <li>
+            [=list/Empty=] |tag|.<a>[[\PendingTransceives]]</a>.
+          </li>
+          <li>
+            Release the connection to the card on the underlying platform.
+          </li>
+        </ol>
+      </div>
+    </section>
+  </section>
+
+  <section id="application-policies"><h3>Application policies</h3>
+    <p>
+      An <dfn data-lt="application policies">application policy</dfn> defines
+      which <a>ISO-DEP</a> cards may be exposed to a page and which
+      <a>command APDU</a>s the page may send to them. It consists of:
+    </p>
+    <ul>
+      <li>
+        a <dfn>classification algorithm</dfn>, run by the UA on a card before
+        the page has access to it, which returns "`match`" or
+        "`no match`"; and
+      </li>
+      <li>
+        a <dfn>command filter</dfn>, which returns "`allowed`" or
+        "`disallowed`" for a <a>command APDU</a>.
+      </li>
+    </ul>
+    <p>
+      To <dfn>classify a card</dfn> given a list of <a>application
+      policies</a>, run each policy's <a>classification algorithm</a> in turn
+      and return the first policy that returns "`match`", or null.
+    </p>
+    <p>
+      To <dfn>check a command APDU</dfn> given a byte sequence |command| and
+      an <a>application policy</a> |policy|, return the result of running
+      |policy|'s <a>command filter</a> on |command|.
+    </p>
+
+    <section><h4>The eMRTD application policy</h4>
+      <p>
+        The <dfn>eMRTD application policy</dfn> is identified by
+        {{NFCIsoDepApplication/"emrtd"}}.
+      </p>
+      <div>
+        Its <a>classification algorithm</a> is:
+        <ol class=algorithm>
+          <li>
+            Send the <a>command APDU</a>
+            `00 A4 04 0C 07 A0 00 00 02 47 10 01` (<code>SELECT</code> of the
+            <a>eMRTD application identifier</a>). If the <a>response APDU</a>
+            ends with `90 00`, return "`match`".
+          </li>
+          <li>
+            Send `00 A4 02 0C 02 01 1C` (<code>SELECT</code> of the
+            <code>EF.CardAccess</code> file) followed by `00 B0 00 00 00`
+            (<code>READ BINARY</code>). If both succeed and the file contains
+            a <code>PACEInfo</code> object, i.e. the DER encoding of the object
+            identifier prefix id-PACE `0.4.0.127.0.7.2.2.4`
+            ([[BSI-TR-03110]], [[ICAO-9303]] part 11), return "`match`".
+          </li>
+          <li>
+            Return "`no match`".
+          </li>
+        </ol>
+        <p class="note">
+          The first step matches documents supporting Basic Access Control;
+          the second matches documents that only support PACE. The UA MAY use
+          other means that give the same result.
+        </p>
+      </div>
+      <div>
+        Its <a>command filter</a>, given a byte sequence |command|, is:
+        <ol class=algorithm>
+          <li>
+            Let |cla|, |ins| and |p1| be the first, second and third bytes of
+            |command|.
+          </li>
+          <li>
+            If |cla| bitwise AND `0x80` is not 0, return "`disallowed`".
+            <p class="note">
+              This excludes proprietary command classes, such as those used by
+              payment applications. They are not used by <a>eMRTD</a>s.
+            </p>
+          </li>
+          <li>
+            If |cla| bitwise AND `0x0C` is not 0, return "`allowed`".
+            <p class="note">
+              Such commands use secure messaging. They are opaque to the UA,
+              are only meaningful to a card that already matched this policy,
+              and can only be produced with the document's access key.
+            </p>
+          </li>
+          <li>
+            If |ins| is `0xA4` (<code>SELECT</code>):
+            <ol>
+              <li>
+                If |p1| is `0x04` (selection by name), return "`allowed`" if
+                the command data of |command| equals the <a>eMRTD application
+                identifier</a>, and "`disallowed`" otherwise.
+              </li>
+              <li>
+                If |p1| is `0x00` or `0x02` (selection by file identifier),
+                return "`allowed`".
+              </li>
+              <li>
+                Return "`disallowed`".
+              </li>
+            </ol>
+          </li>
+          <li>
+            If |ins| is one of `0xB0` or `0xB1` (<code>READ BINARY</code>),
+            `0x84` (<code>GET CHALLENGE</code>), `0x82`
+            (<code>EXTERNAL AUTHENTICATE</code>), `0x88`
+            (<code>INTERNAL AUTHENTICATE</code>), `0x22`
+            (<code>MANAGE SECURITY ENVIRONMENT</code>), `0x86`
+            (<code>GENERAL AUTHENTICATE</code>) or `0xC0`
+            (<code>GET RESPONSE</code>), return "`allowed`".
+          </li>
+          <li>
+            Return "`disallowed`".
+          </li>
+        </ol>
+      </div>
+    </section>
+  </section>
+
+  <section><h3>The <strong>scan()</strong> method</h3>
+    <div>
+      When the <dfn>scan(options)</dfn> method is invoked, the UA MUST run the
+      following <dfn>NFC ISO-DEP listen algorithm</dfn>:
+      <ol class=algorithm>
+        <li>
+          Let |p:Promise| be a new {{Promise}} object.
+        </li>
+        <li>
+          If not currently executing in the currently active <a>top-level
+          browsing context</a>, then reject |p| with an
+          {{"InvalidStateError"}} and return |p|.
+        </li>
+        <li>
+          If the <a>relevant global object</a> of [=this=] does not have
+          <a>transient activation</a>, reject |p| with a
+          {{"NotAllowedError"}} and return |p|.
+        </li>
+        <li>
+          Let |reader:NFCIsoDepReader| be [=this=].
+        </li>
+        <li>
+          Let |signal:AbortSignal| be |options|["{{NFCIsoDepScanOptions/signal}}"]
+          if it [=map/exists=], or null otherwise.
+        </li>
+        <li>
+          If |signal| is [= AbortSignal/aborted =], then reject |p| with
+          |signal|'s [=AbortSignal/abort reason=] and return |p|.
+        </li>
+        <li>
+          Let |policies:list| be the <a>application policies</a> identified by
+          |options|["{{NFCIsoDepScanOptions/applications}}"] if it
+          [=map/exists=], or « the <a>eMRTD application policy</a> »
+          otherwise. If |policies| [=list/is empty=], reject |p| with a
+          {{TypeError}} and return |p|.
+        </li>
+        <li>
+          If |signal| is not null, then
+          <a data-cite="dom#abortsignal-abort-algorithms">add the following
+          abort steps</a> to |signal|:
+          <ol>
+            <li>
+              Remove the tuple whose reader is |reader| from the
+              <a>activated ISO-DEP reader objects</a>.
+            </li>
+            <li>
+              If the <a>activated ISO-DEP reader objects</a> [= list/is
+              empty =], <a>close the active ISO-DEP session</a> and make a
+              request to stop listening for <a>ISO-DEP</a> cards.
+            </li>
+          </ol>
+        </li>
+        <li>
+          Return |p| and run the following steps <a>in parallel</a>:
+          <ol>
+            <li>
+              If the <a>obtain permission</a> steps return false, then reject
+              |p| with a {{"NotAllowedError"}} and abort these steps.
+            </li>
+            <li>
+              If there is no underlying <a>NFC Adapter</a>, or it does not
+              support <a>ISO-DEP</a>, then reject |p| with a
+              {{"NotSupportedError"}} and abort these steps.
+            </li>
+            <li>
+              If the UA is not allowed to access the underlying <a>NFC
+              Adapter</a> (e.g. a user preference), then reject |p| with a
+              {{"NotReadableError"}} and abort these steps.
+            </li>
+            <li>
+              If |reader| is already in the <a>activated ISO-DEP reader
+              objects</a>, then reject |p| with an {{"InvalidStateError"}} and
+              abort these steps.
+            </li>
+            <li>
+              [=list/Append=] &lt;|reader|, |policies|&gt; to the
+              <a>activated ISO-DEP reader objects</a>.
+            </li>
+            <li>
+              Resolve |p|.
+            </li>
+            <li>
+              Whenever the <a>UA</a> detects a card exposing <a>ISO-DEP</a>,
+              run the <a>NFC ISO-DEP reading algorithm</a>.
+            </li>
+          </ol>
+        </li>
+      </ol>
+    </div>
+  </section>
+
+  <section><h3>The NFC ISO-DEP reading algorithm</h3>
+    <div>
+      To handle a card, run the <dfn>NFC ISO-DEP reading algorithm</dfn>:
+      <ol class=algorithm>
+        <li>
+          If <a>NFC is suspended</a>, or the <a>activated ISO-DEP reader
+          objects</a> [=list/is empty=], abort these steps.
+        </li>
+        <li>
+          If the card is <a>blocklisted</a>, abort these steps.
+        </li>
+        <li>
+          The card is now claimed by this algorithm.
+        </li>
+        <li>
+          <a>Close the active ISO-DEP session</a>.
+        </li>
+        <li>
+          Let |requested:list| be the union, in order, of the policies of all
+          tuples in the <a>activated ISO-DEP reader objects</a>.
+        </li>
+        <li>
+          Let |policy| be the result of <a>classify a card</a> given
+          |requested|.
+        </li>
+        <li>
+          If |policy| is null, then [=list/for each=] tuple in the
+          <a>activated ISO-DEP reader objects</a>, <a>fire an event</a> named
+          "`readingerror`" at its reader. Release the connection to the card
+          and abort these steps.
+        </li>
+        <li>
+          Let |target:NFCIsoDepReader| be the reader of the last tuple in the
+          <a>activated ISO-DEP reader objects</a> whose policies contain
+          |policy|.
+        </li>
+        <li>
+          Let |tag:NFCIsoDepTag| be a new {{NFCIsoDepTag}} with
+          <a data-link-for="NFCIsoDepTag">[[\Policy]]</a> set to |policy|, and its attributes set from
+          the card and <a>NFC adapter</a>.
+        </li>
+        <li>
+          Set <a>[[\ActiveIsoDepTag]]</a> to |tag|.
+        </li>
+        <li>
+          <a>Fire an event</a> named "`reading`" at |target| using
+          {{NFCIsoDepReadingEvent}} with its {{NFCIsoDepReadingEvent/tag}}
+          attribute initialized to |tag|.
+        </li>
+      </ol>
+    </div>
+    <p class="note">
+      Only one reader receives the session, because a card can only take
+      part in one exchange at a time. If the card is removed, pending and
+      later {{NFCIsoDepTag/transceive()}} calls reject with a
+      {{"NetworkError"}}.
+    </p>
+  </section>
+</section> <!-- NFCIsoDepReader -->
