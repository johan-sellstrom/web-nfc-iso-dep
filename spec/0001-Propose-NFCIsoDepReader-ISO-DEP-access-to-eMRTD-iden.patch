+  <section><h3>Select the application on an identity document</h3>
+    <p>
+      An {{NFCIsoDepReader}} exposes an <a>eMRTD</a> as an {{NFCIsoDepTag}}.
+      The page exchanges <a>command APDU</a>s with it. This example selects
+      the eMRTD application and checks the status bytes of the response.
+      Reading the document's data additionally requires the access control,
+      secure messaging and authentication steps defined in [[ICAO-9303]],
+      which are outside the scope of this specification.
+    </p>
+    <pre class="example">
+      const SELECT_EMRTD = new Uint8Array([
+        0x00, 0xA4, 0x04, 0x0C, 0x07,
+        0xA0, 0x00, 0x00, 0x02, 0x47, 0x10, 0x01
+      ]);
+
+      const reader = new NFCIsoDepReader();
+      reader.onreading = async ({ tag }) => {
+        const response = await tag.transceive(SELECT_EMRTD);
+        const sw = response.slice(-2);
+        if (sw[0] === 0x90 &amp;&amp; sw[1] === 0x00) {
+          console.log("eMRTD application selected.");
+        }
+        await tag.close();
+      };
+      reader.onreadingerror = () => {
+        console.log("This card is not an identity document.");
+      };
+
+      button.onclick = async () => {
+        await reader.scan({ applications: ["emrtd"] });
+        console.log("Hold your passport to the back of the phone.");
+      };
+    </pre>
+  </section>
+
